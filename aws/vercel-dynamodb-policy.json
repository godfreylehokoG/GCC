{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteAndReadWealthMindsetTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DeleteItem",
        "dynamodb:PutItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:eu-north-1:922839637377:table/wealth_mindset_leads",
        "arn:aws:dynamodb:eu-north-1:922839637377:table/wealth_mindset_event_registrations",
        "arn:aws:dynamodb:eu-north-1:922839637377:table/wealth_mindset_events",
        "arn:aws:dynamodb:eu-north-1:922839637377:table/wealth_mindset_course_leads",
        "arn:aws:dynamodb:eu-north-1:922839637377:table/wealth_mindset_chat_history",
        "arn:aws:dynamodb:eu-north-1:922839637377:table/wealth_mindset_course_leads/index/*",
        "arn:aws:dynamodb:eu-north-1:922839637377:table/wealth_mindset_chat_history/index/*"
      ]
    },
    {
      "Sid": "InvokeBedrockNova",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:eu-north-1:922839637377:inference-profile/eu.amazon.nova-lite-v1:0",
        "arn:aws:bedrock:eu-central-1:922839637377:inference-profile/eu.amazon.nova-lite-v1:0",
        "arn:aws:bedrock:eu-north-1::foundation-model/amazon.nova-lite-v1:0",
        "arn:aws:bedrock:eu-central-1::foundation-model/amazon.nova-lite-v1:0",
        "arn:aws:bedrock:eu-west-1::foundation-model/amazon.nova-lite-v1:0",
        "arn:aws:bedrock:eu-west-3::foundation-model/amazon.nova-lite-v1:0",
        "arn:aws:bedrock:eu-north-1:922839637377:inference-profile/*",
        "arn:aws:bedrock:eu-central-1:922839637377:inference-profile/*",
        "arn:aws:bedrock:eu-west-1:922839637377:inference-profile/*",
        "arn:aws:bedrock:eu-west-3:922839637377:inference-profile/*"
      ]
    }
  ]
}
